# Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep.region.aws.neon.tech/neondb?sslmode=require"

# NextAuth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Google AI (Gemini)
GOOGLE_GENERATIVE_AI_API_KEY="your-api-key"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Cloudflare R2 Storage (https://dash.cloudflare.com/e97df7bfb09acbf14f6a44b36cc979f7/r2/)
R2_ACCOUNT_ID="e97df7bfb09acbf14f6a44b36cc979f7"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="banknotes-media"
R2_PUBLIC_URL="" # Optional (leave blank to use internal /api/media streaming)

# App Config
NEXT_PUBLIC_APP_NAME="Banknote Collection Manager"
NEXT_PUBLIC_APP_VERSION="1.0.0"
